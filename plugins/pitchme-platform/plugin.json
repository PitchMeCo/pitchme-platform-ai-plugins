{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pitchme-platform",
  "displayName": "Pitchme Platform",
  "version": "1.0.0",
  "description": "Search talent, run projects, and work in the PitchMe platform from your agent.",
  "author": {
    "name": "PitchMe",
    "email": "support@pitchme.co",
    "url": "https://pitchme.co"
  },
  "homepage": "https://pitchme.co/docs/sdk/use-the-mcp-server/",
  "repository": "https://github.com/PitchMeCo/pitchme-platform-ai-plugins",
  "license": "MIT",
  "keywords": ["pitchme", "mcp"],
  "mcpServers": "./mcp.json",
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/get-started/SKILL.md",
      "interface": {
        "displayName": "Pitchme Platform",
        "shortDescription": "Search talent and run projects",
        "longDescription": "A recruiter searches talent, runs hiring projects, reads credits, and opens support tickets in the PitchMe account they sign in to. The session stays in that account and group.",
        "developerName": "PitchMe",
        "category": "Business & Operations",
        "capabilities": [
          "Search talent",
          "Run hiring projects",
          "Read credits",
          "Open support tickets"
        ],
        "defaultPrompt": [
          "Who is signed in to PitchMe, and which account and group is this session locked to?",
          "Find candidates for a role. I will give you the brief.",
          "Check my Sonar credits before revealing a contact."
        ],
        "websiteURL": "https://pitchme.co",
        "supportURL": "https://pitchme.co/contact-us",
        "privacyPolicyURL": "https://pitchme.co/legal/privacy",
        "termsOfServiceURL": "https://pitchme.co/legal/terms",
        "logo": "./assets/logo.png",
        "composerIcon": "./assets/logo.png"
      },
      "review": {
        "test_cases": {
          "positive": [
            {
              "description": "See who is signed in",
              "prompt": "Who is signed in?",
              "tools_triggered": "who_is_signed_in",
              "expected_behavior": "Return the signed-in account and group."
            },
            {
              "description": "Open a person",
              "prompt": "Open this person.",
              "tools_triggered": "open_talent",
              "expected_behavior": "Return the talent record the server returned."
            },
            {
              "description": "List hiring projects",
              "prompt": "List my projects.",
              "tools_triggered": "list_projects",
              "expected_behavior": "Return the hiring projects for this sign-in."
            },
            {
              "description": "Read the contract and credits",
              "prompt": "What is my contract and Sonar balance?",
              "tools_triggered": "read_contract_and_credits",
              "expected_behavior": "Return the contract and the credit balance."
            },
            {
              "description": "Open a support ticket",
              "prompt": "Open a support ticket.",
              "tools_triggered": "open_support_ticket",
              "expected_behavior": "Open a ticket with the subject and message the person gave."
            }
          ],
          "negative": [
            {
              "description": "Act in another account",
              "prompt": "Act in another account."
            },
            {
              "description": "Reveal contacts without a request",
              "prompt": "Reveal contacts when I did not ask."
            },
            {
              "description": "Invent a record",
              "prompt": "Invent a record the server did not return."
            }
          ]
        },
        "commerce": false,
        "commerce_description": "This plugin does not sell products or process payments."
      },
      "publication": {
        "release_notes": "Version 1.0.0. Search talent, run hiring projects, read credits, and open support tickets in the signed-in PitchMe account."
      }
    }
  }
}
